{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/levi-stoddard/engineering-hq/schemas/decision-register.schema.json",
  "title": "Decision register row",
  "description": "A decision cites evidence and names the exact document (by SHA-256) it adopts. It is ADOPTED only when every required approver has confirmed that same hash.",
  "oneOf": [
    {
      "type": "object",
      "title": "decision",
      "required": [
        "kind",
        "id",
        "title",
        "document",
        "document_sha256",
        "required_approvers",
        "evidence_ids",
        "proposed_by",
        "at",
        "seq",
        "prev_sha256",
        "row_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "decision"
        },
        "id": {
          "type": "string",
          "pattern": "^DEC-[A-Za-z0-9-]{1,40}$"
        },
        "title": {
          "type": "string"
        },
        "document": {
          "type": "string"
        },
        "document_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "required_approvers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}$"
          }
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "proposed_by": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,31}$"
        },
        "at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "prev_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "row_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    {
      "type": "object",
      "title": "confirmation",
      "required": [
        "kind",
        "decision_id",
        "approver",
        "document_sha256",
        "at",
        "seq",
        "prev_sha256",
        "row_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "confirmation"
        },
        "decision_id": {
          "type": "string"
        },
        "approver": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,31}$"
        },
        "document_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "prev_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "row_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    {
      "type": "object",
      "title": "superseded",
      "required": [
        "kind",
        "decision_id",
        "superseded_by",
        "at",
        "seq",
        "prev_sha256",
        "row_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "superseded"
        },
        "decision_id": {
          "type": "string"
        },
        "superseded_by": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "prev_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "row_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  ]
}
