{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/levi-stoddard/engineering-hq/schemas/release-manifest.schema.json",
  "title": "Release manifest",
  "description": "Pins every file of a release by SHA-256. No timestamps or paths outside the release, so the same files always give the same manifest_sha256.",
  "type": "object",
  "required": [
    "schema",
    "component",
    "version",
    "decision_id",
    "files",
    "tree_sha256",
    "manifest_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "engineering-hq.release-manifest.v1"
    },
    "component": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]{0,63}$"
    },
    "decision_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "tree_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
