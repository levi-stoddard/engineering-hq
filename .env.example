# Copy to .env and fill in. Every value below is a placeholder; .env is gitignored.
# Nothing here is needed for the quickstart (fake connectors, console transport, demo config).
# Both the supervisor and the Slack agent refuse to start while a required value is a placeholder.

# --- Slack agent: mode ---
# fake (offline fixtures) or live (real read-only connectors)
CONNECTORS=fake
# console (type in a terminal) or slack (Socket Mode)
TRANSPORT=console
# plain or dry (adds the occasional wry remark; purely cosmetic)
AGENT_TONE=plain
# Ceilings on answered messages; the agent pauses when one is reached
DAILY_REQUEST_LIMIT=200
MONTHLY_REQUEST_LIMIT=3000

# --- Slack (TRANSPORT=slack) ---
# Bot token from your Slack app (OAuth & Permissions)
SLACK_BOT_TOKEN=your-slack-bot-token
# App-level token with connections:write, for Socket Mode
SLACK_APP_TOKEN=your-slack-app-token
# The one channel the agent answers in (it also answers direct messages from owners)
SLACK_CHANNEL_ID=your-channel-id
# Comma-separated Slack user ids allowed to talk to the agent
SLACK_OWNER_IDS=your-owner-user-ids

# --- Read-only connectors (CONNECTORS=live) ---
# Fine-grained GitHub token with read-only Contents, Issues and Pull requests
GITHUB_TOKEN=your-github-read-only-token
# Comma-separated owner/name repositories the agent may read
GITHUB_REPOS=your-org/your-repo
# Linear personal API key (the connector sends GraphQL queries only)
LINEAR_API_KEY=your-linear-api-key
# Team key used in issue identifiers, e.g. ACME for ACME-123
LINEAR_TEAM_KEY=your-team-key
# OAuth access token issued with the drive.readonly scope only
GOOGLE_ACCESS_TOKEN=your-google-access-token
# The one Drive folder the agent may read
DRIVE_FOLDER_ID=your-drive-folder-id

# --- Supervisor (referenced from supervisor/config.example.yaml) ---
# SHA-256 of each approver's token (python scripts/new_token.py prints both); never the token itself
HQ_OWNER_TOKEN_SHA256=your-owner-token-sha256
HQ_REVIEWER_TOKEN_SHA256=your-reviewer-token-sha256
